# DISPLAY MESSAGE

def display_message(sender, message):
    chat_area.config(state="normal")
    chat_area.insert(
        tk.END,
        sender + ": " + str(message) + "\n\n"
    )
    chat_area.config(state="disabled")
    chat_area.see(tk.END)

