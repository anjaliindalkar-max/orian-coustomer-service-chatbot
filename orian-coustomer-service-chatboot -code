# PROCESS MENU CHOICE

def process_choice(choice):
    global waiting_for_choice, chat_ended

    waiting_for_choice = False
    choice = choice.strip()

    if choice == "12":
        display_message(
            "Bot",
            "Thank you for using Orian Online Store!\nGoodbye!"
        )
        chat_ended = True
        message_entry.config(state="disabled")
        send_button.config(state="disabled")
        return

    menu_functions = {
        "1": store_information,
        "2": business_hours,
        "3": product_information,
        "4": order_tracking,
        "5": payment_information,
        "6": return_refund,
        "7": delivery_information,
        "8": contact_support,
        "9": register_complaint,
        "10": customer_feedback,
        "11": faq
    }

    if choice in menu_functions:
        try:
            result = menu_functions[choice]()
            display_message("Bot", result)

        except Exception as error:
            display_message("Bot", "An error occurred: " + str(error))

    else:
        display_message(
            "Bot",
            "Invalid choice! Please type 'menu' "
            "and select a number from 1 to 12."
        )

# CHATBOT RESPONSE SYSTEM

def chatbot_response(user_input):
    text = user_input.lower().strip()

    if text in ["hi", "hello", "hey", "hii", "good morning"]:
        return "Hello! Welcome to Orian Online Store. How can I help?"

    elif "your name" in text or "who are you" in text:
        return "I am your Orian Customer Support Assistant."

    elif "store" in text or "company" in text:
        return store_information()

    elif any(word in text for word in
             ["hours", "timing", "working time", "open"]):
        return business_hours()

    elif any(word in text for word in
             ["product", "products", "items", "available"]):
        return product_information()

    elif any(word in text for word in
             ["track", "tracking", "order status", "my order"]):
        return order_tracking()

    elif any(word in text for word in
             ["payment", "pay", "upi", "card"]):
        return payment_information()

    elif any(word in text for word in
             ["refund", "return", "exchange"]):
        return return_refund()

    elif any(word in text for word in
             ["delivery", "shipping", "dispatch", "parcel"]):
        return delivery_information()

    elif any(word in text for word in
             ["contact", "phone", "email", "support"]):
        return contact_support()

    elif any(word in text for word in
             ["complaint", "problem", "issue"]):
        return register_complaint()

    elif "feedback" in text or "suggestion" in text:
        return customer_feedback()

    elif "faq" in text or "frequently asked" in text:
        return faq()

    elif "thank" in text:
        return "You're welcome! We are happy to help."

    elif "help" in text:
        return "Type 'menu' to see all customer support options."

    else:
        return (
            "Sorry, I couldn't understand your question.\n"
            "Please type 'menu' to see available services."
        )

# SEND MESSAGE

def send_message(event=None):
    global waiting_for_choice, chat_ended

    if chat_ended:
        return

    message = message_entry.get().strip()

    if message == "":
        return

    display_message("You", message)
    message_entry.delete(0, tk.END)

    if waiting_for_choice:
        process_choice(message)
        return

    if message.lower() == "menu":
        show_menu()
        return

    if message.lower() in ["bye", "goodbye", "exit"]:
        display_message(
            "Bot",
            "Thank you for contacting Orian Online Store. Goodbye!"
        )
        chat_ended = True
        message_entry.config(state="disabled")
        send_button.config(state="disabled")
        return

    response = chatbot_response(message)
    display_message("Bot", response)

